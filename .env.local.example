# ============================================================
# PATCH NOTES — GITHUB RELEASES (opcional)
# Se definido, o site busca as atualizações direto do GitHub Releases
# Formato: "usuario/repositorio"
# ============================================================

GITHUB_REPO=viniciusvieirafx/brasil-role-br
# GITHUB_TOKEN=   # opcional — aumenta o rate limit da API do GitHub

# ============================================================
# PASSO 1 — DISCORD OAUTH2 + BOT
# Acesse: https://discord.com/developers/applications
# 1. Clique em "New Application" e dê um nome
# 2. Vá em "OAuth2" e copie Client ID e Client Secret
# 3. Em "OAuth2 > Redirects" adicione: http://localhost:3000/api/auth/callback
#    (e depois, quando hospedar: https://SEU_DOMINIO/api/auth/callback)
# 4. Vá em "Bot", clique "Add Bot", copie o Token
# 5. Em "Bot > Privileged Gateway Intents" ative SERVER MEMBERS INTENT
# 6. Para convidar o bot: OAuth2 > URL Generator > bot + manage_roles
# ============================================================

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=972901887034654770

# ID do cargo VIP: no Discord, ative o Modo Desenvolvedor (Configurações > Avançado)
# Clique com botão direito no cargo VIP > "Copiar ID do cargo"
DISCORD_VIP_ROLE_ID=

# Link de convite público do seu servidor Discord
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/SEU_LINK

# ============================================================
# PASSO 2 — MERCADO PAGO (PIX)
# Acesse: https://www.mercadopago.com.br/developers/panel
# 1. Crie uma aplicação
# 2. Vá em "Credenciais de PRODUÇÃO" (NÃO use sandbox — QR code de teste não funciona em apps bancários)
# 3. Copie o Access Token de produção abaixo
# 4. Configure o Webhook em "Webhooks":
#    URL: https://SEU_DOMINIO/api/webhook
#    Evento: Pagamentos (payment)
# ============================================================

# ATENÇÃO: Use credencial de PRODUÇÃO, não de teste/sandbox
MP_ACCESS_TOKEN=APP_USR-...

# URL pública do seu site (para o webhook do Mercado Pago)
NEXT_PUBLIC_BASE_URL=https://SEU_DOMINIO

# ============================================================
# PAINEL DE CONTROLE (/controle)
# Defina uma senha forte para acessar o painel de gestão de VIPs.
# ADMIN_SECRET é usado para assinar os cookies de sessão —
# pode ser qualquer string longa e aleatória (diferente da senha).
# ============================================================

ADMIN_PASSWORD=suaSenhaForteAqui
ADMIN_SECRET=outraStringAleatoriaMuitoLonga
