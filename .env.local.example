# ============================================================
# PASSO 1 — DISCORD OAUTH2 + BOT
# Acesse: https://discord.com/developers/applications
# 1. Clique em "New Application" e dê um nome
# 2. Vá em "OAuth2" e copie Client ID e Client Secret
# 3. Em "OAuth2 > Redirects" adicione: http://localhost:3000/api/auth/callback
#    (e depois, quando hospedar: https://SEU_DOMINIO/api/auth/callback)
# 4. Vá em "Bot", clique "Add Bot", copie o Token
# 5. Em "Bot > Privileged Gateway Intents" ative SERVER MEMBERS INTENT
# 6. Para convidar o bot: OAuth2 > URL Generator > bot + manage_roles
# ============================================================

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=972901887034654770

# ID do cargo VIP: no Discord, ative o Modo Desenvolvedor (Configurações > Avançado)
# Clique com botão direito no cargo VIP > "Copiar ID do cargo"
DISCORD_VIP_ROLE_ID=

# Link de convite público do seu servidor Discord
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/SEU_LINK

# ============================================================
# PASSO 2 — OPENPIX
# Acesse: https://app.openpix.com.br
# 1. Crie uma conta empresarial
# 2. Vá em "API & Plugins" e crie um App ID
# 3. Copie o App ID abaixo
# 4. Configure o Webhook em "Configurações > Webhooks":
#    URL: https://SEU_DOMINIO/api/webhook
#    Evento: OPENPIX:CHARGE_COMPLETED
# ============================================================

OPENPIX_APP_ID=
